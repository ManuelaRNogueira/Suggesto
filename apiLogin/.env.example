# Copie pra ".env" e preencha com os valores reais (o .env de verdade nunca é
# commitado — ver .gitignore na raiz do repo). Nenhuma dessas variáveis é
# necessária pra rodar local com o profile "local" (ele já roda sozinho com H2
# em memória, sem banco nem Cloudinary configurados — ver application-local.properties).
#
# Servem pra quando você quiser rodar a API local mas apontando pro profile
# "prod" de verdade (ex: testar contra o banco real), ou como referência do que
# já está configurado no painel do Render em produção.

# "local" ou "prod". Sem essa variável, o profile padrão é "prod" (application.properties).
SPRING_PROFILES_ACTIVE=local

# Porta em que a API sobe. O Render injeta a dele automaticamente.
PORT=8080

# Banco de dados (só usado no profile "prod" — "local" usa H2 em memória).
DB_URL=jdbc:mysql://SEU_HOST:3306/SEU_BANCO?sslMode=DISABLED&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo&nullCatalogMeansCurrent=true
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha

# Cloudinary (upload de fotos). Sem isso, cai pro disco local automaticamente.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Origens liberadas no CORS, separadas por vírgula. "*" (padrão) libera qualquer
# origem, igual ao comportamento de sempre.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://suggesto-site.onrender.com
